      <aliases enabled="yes" />
      <column caption="Average Session Duration" datatype="real" name="[Calculation_WeightedDuration]" role="measure" type="quantitative" default-format="N1">
        <calculation class="tableau" formula="IF SUM([Sessions]) = 0 THEN 0 ELSE SUM([Avg Session Duration (Seconds)] * [Sessions]) / SUM([Sessions]) END" />
      </column>
      <column caption="Page Name" datatype="string" name="[Calculation_PageSelection]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF COUNTD([Page Name]) = 1 THEN MIN([Page Name]) ELSE STR(COUNTD([Page Name])) + &quot; pages selected&quot; END" />
      </column>
