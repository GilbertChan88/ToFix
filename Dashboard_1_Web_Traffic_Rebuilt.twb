      <table>
        <view>
          <datasources>
            <datasource caption="Web Traffic (Enriched)" name="federated.webtraffic" />
          </datasources>
          <datasource-dependencies datasource="federated.webtraffic">
            <column datatype="real" name="[Avg Session Duration (Seconds)]" role="measure" type="quantitative" />
            <column datatype="string" name="[Campaign Duration]" role="dimension" type="nominal" />
            <column datatype="string" name="[Campaign ID]" role="dimension" type="nominal" />
