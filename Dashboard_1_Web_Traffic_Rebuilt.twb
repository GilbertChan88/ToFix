            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
          </pane>
        </panes>
        <rows>([federated.webtraffic].[none:Campaign ID:nk] / [federated.webtraffic].[none:Campaign Name:nk] / [federated.webtraffic].[none:UTM Campaign:nk] / [federated.webtraffic].[none:Department:nk] / [federated.webtraffic].[none:Campaign Type:nk] / [federated.webtraffic].[none:Campaign Objective:nk])</rows>
        <cols>([federated.webtraffic].[day:Campaign Start Date:qk] + [federated.webtraffic].[day:Campaign End Date:qk])</cols>
      </table>
