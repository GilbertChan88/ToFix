      <table>
        <view>
          <datasources>
            <datasource caption="Web Traffic (Enriched)" name="federated.webtraffic" />
          </datasources>
          <datasource-dependencies datasource="federated.webtraffic">
            <column datatype="date" name="[Campaign End Date]" role="dimension" type="ordinal" />
            <column datatype="string" name="[Campaign ID]" role="dimension" type="nominal" />
            <column datatype="string" name="[Campaign Name]" role="dimension" type="nominal" />
            <column datatype="string" name="[Campaign Objective]" role="dimension" type="nominal" />
            <column datatype="date" name="[Campaign Start Date]" role="dimension" type="ordinal" />
            <column datatype="string" name="[Campaign Type]" role="dimension" type="nominal" />
            <column datatype="string" name="[Department]" role="dimension" type="nominal" />
            <column datatype="string" name="[UTM Campaign]" role="dimension" type="nominal" />
            <column-instance column="[Campaign ID]" derivation="None" name="[none:Campaign ID:nk]" pivot="key" type="nominal" />
            <column-instance column="[Campaign Name]" derivation="None" name="[none:Campaign Name:nk]" pivot="key" type="nominal" />
            <column-instance column="[UTM Campaign]" derivation="None" name="[none:UTM Campaign:nk]" pivot="key" type="nominal" />
            <column-instance column="[Department]" derivation="None" name="[none:Department:nk]" pivot="key" type="nominal" />
            <column-instance column="[Campaign Type]" derivation="None" name="[none:Campaign Type:nk]" pivot="key" type="nominal" />
            <column-instance column="[Campaign Objective]" derivation="None" name="[none:Campaign Objective:nk]" pivot="key" type="nominal" />
            <column-instance column="[Campaign Start Date]" derivation="Day" name="[day:Campaign Start Date:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Campaign End Date]" derivation="Day" name="[day:Campaign End Date:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="background-color" value="#FFFFFF" />
