            <column datatype="real" name="[Calculation_WeightedDuration]" role="measure" type="quantitative" caption="Average Session Duration">
              <calculation class="tableau" formula="IF SUM([Sessions]) = 0 THEN 0 ELSE SUM([Avg Session Duration (Seconds)] * [Sessions]) / SUM([Sessions]) END" />
